    {
      "id": "chrome.privacy.permissions-justification",
      "store": "chrome",
      "category": "privacy",
      "title": {
        "en": "Justify every permission",
        "tr": "Her izni gerekçelendir"
      },
      "description": {
        "en": "Request the narrowest permissions the features need, none for future features, and justify each permission and the host permissions on the Privacy practices tab; broad host access makes the review longer."
