    {
      "id": "chrome.review.process",
      "store": "chrome",
      "category": "review",
      "title": {
        "en": "Every submission is reviewed",
        "tr": "Her gönderim incelenir"
      },
      "description": {
        "en": "A submitted item waits in review (PENDING_REVIEW) and is then published, staged when submitted with STAGED_PUBLISH, or rejected with the reason in the developer dashboard. Broad permissions and large code changes make the review longer."
