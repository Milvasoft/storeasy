    {
      "id": "chrome.privacy.data-disclosure",
      "store": "chrome",
      "category": "privacy",
      "title": {
        "en": "Privacy practices: data use, privacy policy, Limited Use",
        "tr": "Gizlilik uygulamaları: veri kullanımı, gizlilik politikası, Sınırlı Kullanım"
      },
      "description": {
        "en": "Declare the user data the item collects on the Privacy practices tab, link an accurate privacy policy when it handles user data, certify compliance with the Limited Use requirements, and get informed consent before collecting data that is not needed for the single purpose."
