  "rules": [
    {
      "id": "chrome.packages.manifest-v3",
      "store": "chrome",
      "category": "packages",
      "title": {
        "en": "Manifest V3 packages only",
        "tr": "Yalnız Manifest V3 paketleri"
      },
      "description": {
        "en": "The store has refused new Manifest V2 items since January 2022 and removed every remaining Manifest V2 item on 31 August 2026; Chrome 139 and later do not run Manifest V2. Every package storeasy uploads must have manifest_version 3 and a service worker instead of a background page."
      },
      "requirement": {
        "level": "required"
      },
      "effectiveDate": null,
      "deadline": "2026-08-31",
      "dateNote": "New Manifest V2 items refused since January 2022; remaining Manifest V2 items removed from the store on 2026-08-31.",
      "check": {
        "kind": "automatic",
        "inputs": [
          "chrome.package"
        ]
      },
      "sources": [
        {
          "url": "https://developer.chrome.com/docs/extensions/develop/migrate/mv2-deprecation-timeline",
          "title": "Manifest V2 support timeline",
          "checkedAt": "2026-11-22"
        }
      ],
      "verified": true
    },
    {
      "id": "chrome.packages.version-higher",
      "store": "chrome",
      "category": "packages",
      "title": {
        "en": "Every upload has a higher version",
        "tr": "Her yükleme daha yüksek sürüm taşır"
      },
      "description": {
        "en": "The manifest version (one to four dot separated integers from 0 to 65535, no leading zeros) must be higher than the published one, or the upload fails."
      },
      "requirement": {
        "level": "required"
      },
      "effectiveDate": null,
      "deadline": null,
      "params": {
        "maxParts": 4,
        "maxPartValue": 65535
      },
      "check": {
        "kind": "automatic",
        "inputs": [
          "chrome.package"
        ]
      },
      "sources": [
        {
          "url": "https://developer.chrome.com/docs/webstore/using-api",
          "title": "Use the Chrome Web Store API",
          "checkedAt": "2026-11-22"
        },
        {
          "url": "https://developer.chrome.com/docs/extensions/reference/manifest/version",
          "title": "Manifest: version",
          "checkedAt": "2026-11-22"
        }
      ],
      "verified": true
    },
    {
      "id": "chrome.packages.zip-root",
      "store": "chrome",
      "category": "packages",
      "title": {
        "en": "ZIP with manifest.json at its root, up to 2 GB",
        "tr": "Kökünde manifest.json olan ZIP, en fazla 2 GB"
      },
      "description": {
        "en": "The package is a ZIP of the extension folder contents with manifest.json at its root; the store takes packages up to 2 GB and creates no item through the API (the first version is uploaded in the developer dashboard)."
      },
      "requirement": {
        "level": "required"
      },
      "effectiveDate": null,
      "deadline": null,
      "params": {
        "maxFileSizeBytes": 2147483648
      },
      "check": {
        "kind": "automatic",
        "inputs": [
