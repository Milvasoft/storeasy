    {
      "id": "chrome.policy.remote-code",
      "store": "chrome",
      "category": "policy",
      "title": {
        "en": "No remotely hosted code",
        "tr": "Uzaktan barındırılan kod yok"
      },
      "description": {
        "en": "In Manifest V3 the full functionality must be in the package: no external scripts and no eval of fetched strings (the Debugger and User Scripts APIs are the exceptions). Obfuscation is prohibited, minification is allowed."
      },
      "requirement": {
