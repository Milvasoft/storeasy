    {
      "id": "chrome.review.visibility",
      "store": "chrome",
      "category": "review",
      "title": {
        "en": "Visibility and trusted testers are set in the dashboard",
        "tr": "Görünürlük ve test kullanıcıları panoda ayarlanır"
