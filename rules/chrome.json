      "verified": true
    },
    {
      "id": "chrome.listing-limits.metadata",
      "store": "chrome",
      "category": "listing-limits",
      "title": {
        "en": "Accurate metadata, no keyword spam",
        "tr": "Doğru meta veri, anahtar kelime istismarı yok"
      },
      "description": {
        "en": "Titles, descriptions and images must describe the item accurately; repeating the same keyword more than five times is keyword spam."
