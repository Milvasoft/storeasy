    {
      "id": "chrome.graphics.listing-assets",
      "store": "chrome",
      "category": "graphics",
      "title": {
        "en": "Listing: icon, screenshots and promo tile in the dashboard",
        "tr": "Mağaza sayfası: simge, ekran görüntüleri ve tanıtım karosu panoda"
      },
      "description": {
        "en": "The store listing (detailed description, category, language, screenshots of 1280x800 or 640x400, the 440x280 small promo tile) is edited in the developer dashboard: the Chrome Web Store API has no listing calls. A blank description, a missing icon or missing screenshots get an item rejected."
      },
      "requirement": {
        "level": "required"
      },
      "effectiveDate": null,
      "deadline": null,
      "check": {
