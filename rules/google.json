    {
      "id": "google.target-api.mobile-new-and-updates",
      "store": "google",
      "category": "target-api",
      "title": {
        "en": "Target API 36 for new apps and updates",
        "tr": "Yeni uygulamalar ve güncellemeler için hedef API 36"
      },
      "description": {
        "en": "New apps and app updates (phones and tablets) must target Android 16 (API level 36) or higher to be submitted. An extension until 2026-11-01 could be requested; that window has passed.",
        "tr": "Yeni uygulamalar ve güncellemeler Android 16 (API 36) veya üstünü hedeflemeli."
      },
      "appliesWhen": {
        "platforms": [
          "android"
        ],
        "packageTypes": [
          "aab",
          "apk"
        ],
        "distribution": [
          "new-app",
          "update"
        ]
      },
      "requirement": {
        "level": "required"
      },
      "effectiveDate": "2026-08-31",
      "deadline": null,
      "params": {
        "minTargetSdk": 36
      },
      "check": {
        "kind": "automatic",
        "inputs": [
          "build.targetSdk",
          "play.tracks"
        ]
      },
      "sources": [
        {
          "url": "https://support.google.com/googleplay/android-developer/answer/11926878",
          "title": "Play Console Help: Target API level requirements",
          "checkedAt": "2026-11-18"
        }
      ],
      "verified": true,
      "notes": "Permanently private apps for a single organization (internal distribution only) are exempt."
    },
