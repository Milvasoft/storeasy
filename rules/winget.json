      "id": "winget.review.validation-pipeline",
      "store": "winget",
      "category": "review",
      "title": {
        "en": "Validation pipeline and moderator approval",
        "tr": "Doğrulama hattı ve moderatör onayı"
      },
      "description": {
        "en": "Each pull request goes through the validation pipeline (manifest checks, installation, security scans) and is labelled with the result (Validation-Completed or an error label); community moderators approve it (Moderator-Approved) and the merge publishes the version."
      },
      "requirement": {
        "level": "required"
