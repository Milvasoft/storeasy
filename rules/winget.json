    {
      "id": "winget.policy.installer-types",
      "store": "winget",
      "category": "policy",
      "title": {
        "en": "Allowed installer types",
        "tr": "İzin verilen yükleyici türleri"
      },
      "description": {
        "en": "MSIX, APPX, MSI and EXE based installers (also inside a zip) are accepted under manifests/; script installers are banned, font installers go under fonts/ only."
      },
      "requirement": {
        "level": "required"
      },
      "effectiveDate": null,
      "deadline": null,
      "check": {
