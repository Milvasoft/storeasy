    {
      "id": "winget.packages.installer-hash",
      "store": "winget",
      "category": "packages",
      "title": {
        "en": "InstallerSha256 matches the download",
        "tr": "InstallerSha256 indirilen dosyayla eşleşir"
      },
      "description": {
        "en": "Each installer carries the SHA256 of the file at its address. The validation pipeline downloads it again and labels a mismatch Error-Hash-Mismatch. storeasy computes the hash from the download when the plan is applied."
      },
      "requirement": {
        "level": "required"
      },
      "effectiveDate": null,
