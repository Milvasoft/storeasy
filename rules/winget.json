    {
      "id": "winget.api-access.github-token",
      "store": "winget",
      "category": "api-access",
      "title": {
        "en": "A GitHub token that can push to the fork and open pull requests",
        "tr": "Fork'a gönderip pull request açabilen bir GitHub token'ı"
      },
      "description": {
        "en": "storeasy pushes a branch to the owner fork of winget-pkgs and opens the pull request with the owner GitHub token. A classic personal access token with the public_repo scope does both; a fine-grained token can push to the fork, but GitHub refuses it a pull request in a repository its owner does not own, so storeasy then gives the compare page to open it by hand."
      },
      "requirement": {
        "level": "required"
      },
      "effectiveDate": null,
      "deadline": null,
      "check": {
        "kind": "automatic",
        "inputs": [
          "connection.verify"
        ]
      },
      "sources": [
        {
          "url": "https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens",
          "title": "GitHub Docs: Managing your personal access tokens",
          "checkedAt": "2026-11-22"
        }
      ],
      "verified": false,
      "notes": "The fine-grained token limit is reported by GitHub users (community discussions) and seen as a 403 from the pull request API; GitHub documentation does not state it outright."
    }
