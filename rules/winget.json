  "rules": [
    {
      "id": "winget.packages.manifest-schema",
      "store": "winget",
      "category": "packages",
      "title": {
        "en": "Manifests follow the manifest schema",
        "tr": "Manifestler manifest şemasına uyar"
      },
      "description": {
        "en": "Every version is a set of YAML manifests (version, default locale, installer, optional locales) that validates against the manifest schema: the required fields, the identifier and version patterns and the same PackageIdentifier, PackageVersion and ManifestVersion in every file. storeasy writes schema 1.12.0, the version wingetcreate writes."
      },
      "requirement": {
        "level": "required"
      },
      "effectiveDate": null,
      "deadline": null,
      "check": {
        "kind": "automatic",
        "inputs": [
          "winget.manifests"
        ]
      },
      "sources": [
        {
          "url": "https://github.com/microsoft/winget-pkgs/tree/master/doc/manifest/schema",
          "title": "winget-pkgs: manifest schema",
          "checkedAt": "2026-11-22"
        },
        {
          "url": "https://github.com/microsoft/winget-cli/blob/master/schemas/JSON/manifests/v1.12.0/manifest.installer.1.12.0.json",
          "title": "winget-cli: installer manifest JSON schema 1.12.0",
          "checkedAt": "2026-11-22"
        },
        {
          "url": "https://github.com/microsoft/winget-cli/blob/master/schemas/JSON/manifests/v1.12.0/manifest.defaultLocale.1.12.0.json",
          "title": "winget-cli: default locale manifest JSON schema 1.12.0",
          "checkedAt": "2026-11-22"
        }
      ],
      "verified": true
    },
    {
      "id": "winget.packages.multi-file-manifests",
      "store": "winget",
      "category": "packages",
      "title": {
        "en": "Multi-file manifests only, no singleton",
        "tr": "Yalnız çok dosyalı manifest, tek dosya değil"
      },
      "description": {
        "en": "Singleton manifests are prohibited in the community repository; a version needs at least a version, a default locale and an installer manifest."
      },
      "requirement": {
        "level": "required"
      },
      "effectiveDate": null,
      "deadline": null,
      "check": {
        "kind": "automatic",
        "inputs": [
          "winget.manifests"
        ]
      },
      "sources": [
        {
          "url": "https://github.com/microsoft/winget-pkgs/blob/master/doc/Policies.md",
          "title": "winget-pkgs: Policies",
          "checkedAt": "2026-11-22"
        },
        {
          "url": "https://github.com/microsoft/winget-pkgs/blob/master/doc/Authoring.md",
          "title": "winget-pkgs: Authoring manifests",
          "checkedAt": "2026-11-22"
        }
      ],
      "verified": true
    },
    {
      "id": "winget.policy.one-version-per-pr",
      "store": "winget",
      "category": "policy",
      "title": {
        "en": "One package version per pull request",
        "tr": "Her pull request tek paket sürümü"
      },
      "description": {
        "en": "A pull request changes the manifests of one package version and no other file. storeasy opens one pull request per plan."
      },
      "requirement": {
        "level": "required"
      },
      "effectiveDate": null,
      "deadline": null,
      "check": {
        "kind": "automatic",
        "inputs": [
          "winget.pullRequest"
        ]
      },
      "sources": [
        {
          "url": "https://github.com/microsoft/winget-pkgs/blob/master/CONTRIBUTING.md",
          "title": "winget-pkgs: Contributing",
          "checkedAt": "2026-11-22"
        },
        {
          "url": "https://github.com/microsoft/winget-pkgs/blob/master/.github/PULL_REQUEST_TEMPLATE.md",
          "title": "winget-pkgs: pull request template",
          "checkedAt": "2026-11-22"
        }
      ],
      "verified": true
    },
    {
      "id": "winget.policy.no-duplicates",
      "store": "winget",
      "category": "policy",
      "title": {
        "en": "No duplicate version or pull request",
        "tr": "Aynı sürüm ya da pull request ikinci kez açılmaz"
      },
      "description": {
        "en": "Check that no other open pull request changes the same manifest, and do not submit a version that is already in the repository."
      },
      "requirement": {
        "level": "required"
      },
      "effectiveDate": null,
      "deadline": null,
      "check": {
        "kind": "automatic",
        "inputs": [
          "winget.versions",
          "winget.pullRequests"
        ]
      },
      "sources": [
        {
          "url": "https://github.com/microsoft/winget-pkgs/blob/master/.github/PULL_REQUEST_TEMPLATE.md",
          "title": "winget-pkgs: pull request template",
          "checkedAt": "2026-11-22"
        }
      ],
      "verified": true
    },
    {
      "id": "winget.policy.installer-url-publisher",
      "store": "winget",
      "category": "policy",
      "title": {
        "en": "Installer addresses are the publisher's own distribution",
        "tr": "Yükleyici adresi yayıncının kendi dağıtımıdır"
      },
      "description": {
        "en": "Installer URLs come from official sources or the publisher and must be discoverable on the publisher's website. Prefer stable addresses specific to the version: a vanity URL whose binary is replaced breaks the hash."
      },
      "requirement": {
        "level": "required"
      },
      "effectiveDate": null,
      "deadline": null,
      "check": {
        "kind": "automatic",
        "inputs": [
          "winget.installers"
        ]
      },
      "sources": [
        {
          "url": "https://github.com/microsoft/winget-pkgs/blob/master/doc/Policies.md",
          "title": "winget-pkgs: Policies",
          "checkedAt": "2026-11-22"
        },
        {
          "url": "https://github.com/microsoft/winget-pkgs/blob/master/doc/Authoring.md",
          "title": "winget-pkgs: Authoring manifests",
          "checkedAt": "2026-11-22"
        }
      ],
      "verified": true
    },
    {
      "id": "winget.policy.unattended-install",
      "store": "winget",
      "category": "policy",
      "title": {
        "en": "Installers run without user interaction",
        "tr": "Yükleyiciler kullanıcı müdahalesi olmadan çalışır"
      },
      "description": {
        "en": "Packages must install silently; the default silent with progress mode may show a window but must not need the user. EXE installers give their silent switches in InstallerSwitches."
      },
      "requirement": {
        "level": "required"
      },
      "effectiveDate": null,
      "deadline": null,
      "check": {
        "kind": "automatic",
