# Backend origin. The client calls ${VITE_API_URL}/api/v1.0/... and the live hub at ${VITE_API_URL}/hubs/activity.
# Leave empty for one origin: the Vite dev proxy in development, nginx in the image (/api, /hubs, /mcp -> API).
VITE_API_URL=

# Dev-only proxy target used by vite.config.ts when VITE_API_URL is empty.
VITE_API_PROXY=

# AGPL-3.0 section 13: where this deployment's source code is published (footer "Source code" link).
# Empty means the upstream repository. Point it at your fork if you run a modified storeasy.
VITE_SOURCE_URL=

# Dev only: true answers the API and the live hub from the in-browser mock (src/mocks), no backend needed.
VITE_MOCK_API=
