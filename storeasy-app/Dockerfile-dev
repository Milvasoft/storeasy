# Local image: the same as Dockerfile without the platform pin. The API runs next to it in docker compose; the browser
# reaches everything through this container's nginx (one origin), so VITE_API_URL stays empty.
FROM node:26-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

ARG VITE_API_URL=
ENV VITE_API_URL=$VITE_API_URL
ARG VITE_SOURCE_URL=
ENV VITE_SOURCE_URL=$VITE_SOURCE_URL
RUN npm run build

FROM nginx:alpine AS final
ENV STOREASY_API_UPSTREAM=http://storeasy-api:8080
ENV NGINX_ENVSUBST_FILTER=STOREASY_
COPY nginx.conf /etc/nginx/templates/default.conf.template
COPY nginx-security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
