# storeasy self-host settings. Copy to .env (never commit .env) and fill in.
# Generate random values with:
#   openssl rand -base64 32    # 32 bytes, base64 (STOREASY_MASTER_KEY)
#   openssl rand -hex 32       # 64 hex characters (STOREASY_TOKEN_KEY, passwords, S3 keys)
# PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#             [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))

# Public address of the web app (e-mail links). Example: https://storeasy.example.com
STOREASY_BASE_URL=

# Required secrets.
# Seals store credentials (AES-256-GCM envelope). Back it up outside the server; losing it means re-entering every
# store connection. openssl rand -base64 32
STOREASY_MASTER_KEY=
STOREASY_MASTER_KEY_VERSION=1
# Signs access tokens, at least 32 characters. openssl rand -hex 32
STOREASY_TOKEN_KEY=
# PostgreSQL password. openssl rand -hex 32
POSTGRES_PASSWORD=
POSTGRES_USER=storeasy
POSTGRES_DB=storeasy

# Object storage (SeaweedFS S3 in this stack). openssl rand -hex 16 / openssl rand -hex 32
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=storeasy
S3_REGION=us-east-1
# Address of the S3 API as browsers, CI runners and the API container reach it (presigned URLs point here).
# Example: https://files.storeasy.example.com (reverse proxy to S3_PORT)
S3_PUBLIC_URL=
S3_BIND=127.0.0.1
S3_PORT=8333

# Web (nginx) port for the reverse proxy in front.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Who may register: Open, InviteOnly or Closed. Start with Open, switch after your own account exists.
STOREASY_REGISTRATION_MODE=Open

# E-mail: Smtp (self-host) or Notifike. Smtp needs SMTP_HOST and SMTP_FROM, or the API stops at startup.
STOREASY_EMAIL_PROVIDER=Smtp
STOREASY_EMAIL_FROM_NAME=storeasy
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ENABLE_SSL=true
NOTIFIKE_BASE_URL=
NOTIFIKE_API_KEY=

# Background e-mail sender (e-mails are queued in the database and sent from there).
STOREASY_EMAIL_OUTBOX_ENABLED=true

# Store job runner and the scheduled syncs (with several API instances keep the schedules on in one).
STOREASY_JOBS_ENABLED=true
STOREASY_JOBS_WORKERS=2
STOREASY_SCHEDULES_ENABLED=true

# Optional: sign in with Google. OAuth client of type Web application, redirect URI
# <STOREASY_BASE_URL>/auth/google/callback. Empty disables it.
STOREASY_GOOGLE_CLIENT_ID=
STOREASY_GOOGLE_CLIENT_SECRET=

# Optional: browser notifications (VAPID P-256 key pair, base64url; generation commands in docs/self-host.md).
# Empty disables them. Changing the pair makes every browser subscribe again.
STOREASY_WEBPUSH_PUBLIC_KEY=
STOREASY_WEBPUSH_PRIVATE_KEY=
STOREASY_WEBPUSH_SUBJECT=mailto:admin@localhost

# Apple delivery of CI packages: Api (storeasy uploads the IPA) or External (the CI uploads, storeasy waits for the build).
STOREASY_APPLE_UPLOAD_MODE=Api

# Optional observability. Empty disables.
SEQ_URI=
OTEL_COLLECTOR_URL=

# Redis key prefix (change it when several storeasy instances share one Redis).
STOREASY_CACHE_PREFIX=storeasy

# AGPL-3.0 section 13: public source of the version you run (your fork if you changed the code). Empty: upstream.
STOREASY_SOURCE_URL=
STOREASY_VERSION=
# Source commit shown on the system status page, for example the output of: git rev-parse --short HEAD
STOREASY_COMMIT=

# Prebuilt images instead of building from this checkout (optional).
STOREASY_API_IMAGE=storeasy-api:local
STOREASY_WEB_IMAGE=storeasy-web:local
