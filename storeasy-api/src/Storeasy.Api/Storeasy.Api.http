@Storeasy.Api_HostAddress = http://localhost:5000

# Liveness: touches nothing.
GET {{Storeasy.Api_HostAddress}}/api/v1.0/healthcheck
Accept: application/json

###

# Readiness: 200 when the database and Redis answer, 503 otherwise.
GET {{Storeasy.Api_HostAddress}}/api/v1.0/healthcheck/ready
Accept: application/json

###
