{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Information",
      "System": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnectionString": ""
  },
  "ApiHost": {
    "HttpUrl": "http://localhost:5000",
    "HttpsUrl": "https://localhost:5001"
  },
  "HealthChecksUI": {
    "Webhooks": [
      {
        "Name": "Internal",
        "Uri": "/api/v1/healthcheck/alert",
        "Payload": "{ \"message\": \"Webhook report for [[LIVENESS]]: [[FAILURE]] - Description: [[DESCRIPTIONS]]\"}",
        "RestoredPayload": "{ \"message\": \"[[LIVENESS]] is back to life\"}"
      }
    ],
    "EvaluationTimeInSeconds": 10,
    "MinimumSecondsBetweenFailureNotifications": 60
  },
  "Milvasoft": {
    "Localization": {
      "Resx": {
        "ManagerLifetime": 2, //Transient
        "KeyFormat": "{0}",
        "KeyFormatDelegate": null,
        "UseInMemoryCache": true,
        "MemoryCacheEntryOptions": null,
        "ResourcesPath": null,
        "ResourcesFolderPath": null
      },
      "Redis": {
        "ManagerLifetime": 2, //Transient
        "KeyFormat": "_ML_{0}_{1}",
        "KeyFormatDelegate": null,
        "UseInMemoryCache": true,
        "MemoryCacheEntryOptions": null,
        "ResourcesPath": null,
        "ResourcesFolderPath": null,
        "RedisOptions": {
          "AccessorLifetime": 0, //Singleton
          "ConnectionString": "redis"
        }
      }
    },
    "Interception": {
      "Log": {
        "InterceptorLifetime": 1, //Scoped
        "AsyncLogging": true,
        "LogDefaultParameters": false,
        "UseUtcForLogTimes": true,
        "ExcludeResponseMetadataFromLog": true,
        "ExtraLoggingPropertiesSelector": null
      },
      "Response": {
        "InterceptorLifetime": 1, //Scoped
        "MetadataCreationEnabled": true,
        "ApplyMetadataRules": true,
        "TranslateResultMessages": true,
        "TranslateMetadata": true,
        "HideByRoleFunc": null,
        "ApplyLocalizationFunc": null
      },
      "Cache": {
        "InterceptorLifetime": 1, //Scoped
        //"CacheAccessorAssemblyQualifiedName": "Milvasoft.Caching.InMemory.Accessor.MemoryCacheAccessor, Milvasoft.Caching.InMemory, Version=8.1.9.0, Culture=neutral, PublicKeyToken=null",
        "IncludedRequestHeaderKeys": [ "accept-language" ]
      },
      "Transaction": {
        "InterceptorLifetime": 1, //Scoped
        "DbContextAssemblyQualifiedName": "Storeasy.Infrastructure.Persistence.Context.StoreasyDbContext, Storeasy.Infrastructure, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
      },
      "WithNoLock": {
        "InterceptorLifetime": 1, //Scoped
        "DbContextAssemblyQualifiedName": "Storeasy.Infrastructure.Persistence.Context.StoreasyDbContext, Storeasy.Infrastructure, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null"
      }
    },
    "Caching": {
      "Redis": {
        "AccessorLifetime": 0, //Singleton
        "ConnectionString": "redis"
      },
      "InMemory": {
        "AccessorLifetime": 0, //Singleton
        "MemoryCacheOptions": null
      }
    },
    "FileOperations": {
      "Json": {
        "Lifetime": 0, //Singleton
        "BasePath": null,
        "EncryptionKey": "", // User secrets locally, Milvasoft__FileOperations__Json__EncryptionKey in containers
        "CultureCode": "en-US"
      }
    },
    "DataAccess": {
      "DbContext": {
        "DynamicFetch": {
          "EntityAssemblyName": "Storeasy.Domain"
        },
        "UseUtcForDateTime": true,
        "DefaultSoftDeletionState": 0, // Passive
        "GetCurrentUserNameDelegate": null
      },
      "Repository": {
        "DefaultSaveChangesChoice": 0, // AfterEveryOperation
        "DefaultSoftDeletedFetchState": false,
        "ResetSoftDeletedFetchStateToDefault": true
      },
      "Auditing": {
        "AuditCreationDate": true,
        "AuditCreator": true,
        "AuditModificationDate": true,
        "AuditModifier": true,
        "AuditDeletionDate": true,
        "AuditDeleter": true
      }
    },
    "Identity": {
      "User": {
        "AllowedUserNameCharacters": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._@+",
        "RequireUniqueEmail": false
      },
      "Password": {
        "RequiredLength": 6,
        "RequiredUniqueChars": 1,
        "RequireNonAlphanumeric": true,
        "RequireLowercase": true,
        "RequireUppercase": true,
        "RequireDigit": true
      },
      "Lockout": {
        "AllowedForNewUsers": true,
        "MaxFailedAccessAttempts": 5,
        "DefaultLockoutTimeSpan": 5
      },
      "SignIn": {
        "RequireConfirmedEmail": false,
        "RequireConfirmedPhoneNumber": false
      },
      "Token": {
        "UseUtcForDateTimes": true,
        "ExpirationMinute": 30,
        "TokenValidationParameters": {
          "ValidateIssuer": true,
          "ValidateAudience": true,
          "ValidIssuer": "Storeasy",
          "ValidAudience": "Storeasy"
        },
        "SecurityKeyType": 0, // Symmetric
        "SymmetricPublicKey": "" // Set with user secrets locally, Milvasoft__Identity__Token__SymmetricPublicKey in containers
      }
    }
  },
  "Storeasy": {
    "Encryption": {
      "MasterKey": "", // Base64 32 bytes. User secrets locally, Storeasy__Encryption__MasterKey in containers. Never commit a value.
      "KeyVersion": 1
    },
    "Jobs": {
      "Enabled": true, // Whether this instance runs store jobs (every instance can queue them)
      "Workers": 2,
      "PollIntervalMilliseconds": 2000,
      "LeaseSeconds": 300,
      "DefaultMaxAttempts": 3,
      "RetryBaseDelaySeconds": 30,
      "RetryMaxDelaySeconds": 900
    },
    // SingleTeam: one team on its own instance (first run setup with a code from the log, one organization, people join
    // by invitation). MultiTenant: a hosted instance for many customers (registration by Registration:Mode, many organizations).
    "Mode": "SingleTeam",
    "Registration": {
      "Mode": "Open" // Open, InviteOnly or Closed. MultiTenant only: a single team instance is always InviteOnly.
    },
    "Bootstrap": {
      "SetupCode": "" // Optional fixed first run setup code (at least 12 characters) for automated installs; empty: generated and logged. Never commit a value.
    },
    "App": {
      "BaseUrl": "" // Public address of the web app, used in e-mail links. Required outside Development.
    },
    "Email": {
      "Provider": "Smtp", // Smtp (self-host), Notifike (Milvasoft hosting) or Log (Development only)
      "FromName": "storeasy",
      "Smtp": {
        "Host": "",
        "Port": 587,
        "UserName": "",
        "Password": "", // User secrets locally, Storeasy__Email__Smtp__Password in containers. Never commit a value.
        "From": "",
        "EnableSsl": true
      },
      "Notifike": {
        "BaseUrl": "",
        "ApiKey": "" // Storeasy__Email__Notifike__ApiKey in containers. Never commit a value.
      },
      "Outbox": {
        "Enabled": true, // Whether this instance runs the background e-mail sender (every instance can queue)
        "PollIntervalMilliseconds": 1000,
        "MaxAttempts": 6,
        "RetryBaseDelaySeconds": 30,
        "LeaseSeconds": 120
      }
    },
    "Auth": {
      "Google": {
        "ClientId": "", // OAuth client (Web application); redirect URI {Storeasy:App:BaseUrl}/auth/google/callback. Empty disables Google sign in.
        "ClientSecret": "", // Storeasy__Auth__Google__ClientSecret in containers. Never commit a value.
        "Authority": "https://accounts.google.com",
        "StateLifetimeMinutes": 10
      }
    },
    "WebPush": {
      "Subject": "mailto:admin@localhost", // Contact the push services may use (mailto: or https)
      "PublicKey": "", // VAPID public key (base64url, 65 bytes); see docs/self-host.md. Empty disables web push.
      "PrivateKey": "", // Storeasy__WebPush__PrivateKey in containers. Never commit a value.
      "TimeToLiveSeconds": 86400
    },
    "Ai": {
      // Review reply drafts with Claude. Each organization saves its own Anthropic API key in its settings; none is set here.
      "Model": "claude-haiku-5-5", // Lowest cost current model
      "MaxTokens": 1024,
      "Effort": "low",
      "TimeoutSeconds": 60
    }
  },
  "Storage": {
    "S3": {
      "Bucket": "", // Empty disables file uploads (the endpoints answer 503)
      "Region": "eu-central-1",
      "AccessKey": "", // Storage__S3__AccessKey in containers. Never commit a value.
      "SecretKey": "", // Storage__S3__SecretKey in containers. Never commit a value.
      "ServiceUrl": "", // S3 compatible endpoint (SeaweedFS locally); empty for AWS S3
      "ForcePathStyle": true,
      "PresignedUrlLifetimeMinutes": 30
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Expressions", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Logger",
        "Args": {
          "configureLogger": {
            "Filter": [
              {
                "Name": "ByExcluding",
                "Args": {
                  "expression": "SourceContext = 'Storeasy.Api.Middlewares.RequestResponseLoggingMiddleware'"
                }
              },
              {
                "Name": "ByExcluding",
                "Args": {
                  "expression": "SourceContext = 'Storeasy.Infrastructure.Logging.StoreasyDbLogger'"
                }
              }
            ],
            "WriteTo": [
              {
                "Name": "Console"
              }
            ]
          }
        }
      }
    ]
  }
}
