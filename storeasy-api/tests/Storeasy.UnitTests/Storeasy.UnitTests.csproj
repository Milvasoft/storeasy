<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Configurations>Debug;Release;TemplateTest</Configurations>
  </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<Nullable>disable</Nullable>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' != 'Debug'">
		<Nullable>disable</Nullable>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AsyncFixer" Version="2.1.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
	  <PackageReference Include="FluentAssertions" Version="[7.2.2]" />
	  <PackageReference Include="Moq" Version="4.21.0" />
	  <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Storeasy.Api\Storeasy.Api.csproj" />
    <ProjectReference Include="..\..\src\Storeasy.Application\Storeasy.Application.csproj" />
    <ProjectReference Include="..\..\src\Storeasy.Domain\Storeasy.Domain.csproj" />
    <ProjectReference Include="..\..\src\Storeasy.Infrastructure\Storeasy.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <None Include="InfrastructureTests\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="InfrastructureTests\Fixtures\*.xml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="InfrastructureTests\Fixtures\*.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="InfrastructureTests\Fixtures\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="UtilsTests\Fixtures\StoreMetrics\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
