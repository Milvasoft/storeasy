{
  "name": "storeasy-tools",
  "private": true,
  "version": "0.1.0",
  "description": "Client tooling for storeasy: the storeasy CLI and storeasy-mcp bridge, the GitHub Action and the Azure DevOps task.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "storeasy-cli",
    "upload-action",
    "azure-devops-task"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "eslint . && node scripts/check-text.mjs && npm run typecheck --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "licenses": "node scripts/check-licenses.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
