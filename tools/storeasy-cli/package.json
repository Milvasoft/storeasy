{
  "name": "storeasy",
  "version": "0.1.0",
  "description": "storeasy CLI and storeasy-mcp bridge: upload builds from any CI, and give local MCP clients file access to the remote storeasy MCP.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "keywords": ["app-store-connect", "google-play", "microsoft-store", "ci", "mcp", "storeasy"],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "storeasy": "dist/cli.js",
    "storeasy-mcp": "dist/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
